{
  "name": "gitdash",
  "version": "1.0.2",
  "description": "Lightweight Git dashboard in system tray",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "icons": "tauri icon ./public/icon.png",
    "tb": "tauri build",
    "tb:x64": "tauri build --target x86_64-pc-windows-msvc",
    "tb:arm": "tauri build --target aarch64-pc-windows-msvc"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/lang-vue": "^0.1.3",
    "@codemirror/language": "^6.12.4",
    "@codemirror/legacy-modes": "^6.5.4",
    "@codemirror/state": "^6.7.2",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.11",
    "@iconify/vue": "^5.0.1",
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.0.0",
    "@tauri-apps/plugin-fs": "^2.0.0",
    "@tauri-apps/plugin-global-shortcut": "^2.0.0",
    "@tauri-apps/plugin-os": "^2.3.2",
    "@tauri-apps/plugin-shell": "^2.0.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "clsx": "^2.1.1",
    "lucide-vue-next": "^0.500.0",
    "pinia": "^3.0.0",
    "reka-ui": "^2.10.4",
    "tailwind-merge": "^3.3.0",
    "tw-animate-css": "^1.4.0",
    "vue": "^3.5.42",
    "vue-codemirror": "^6.1.1",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.0.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.0",
    "vite": "^8.2.2",
    "vue-tsc": "^2.1.0"
  }
